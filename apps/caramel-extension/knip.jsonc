{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "caramel-env.js",
        "coupon-constants.generated.js",
        "cart-signals.js",
        "caramel-base.js",
        "dom-utils.js",
        "store-detect.js",
        "coupon-apply.js",
        "coupon-fetch.js",
        "coupon-runner.js",
        "UI-helpers.js",
        "inject.js",
        // Loaded by URL (import of runtime.getURL) in coupon-box-discovery.js,
        // so no import statement names it.
        "coupon-box-outline.js",
        "coupon-box-selectors.js",
        // Bundled on its own as assets/coupon-box-finder.js
        // (scripts/finder-bundle.mjs) and loaded by URL in
        // coupon-box-finder-loader.js, so no import statement names it.
        "coupon-box-discovery.js",
        "background.js",
        "popup-core.js",
        "entrypoints/*.ts",
        "eslint.config.cjs",
        "scripts/**/*.mjs",
        "tests/**/*.{mjs,tsx}",
    ],
    "project": ["**/*.{js,cjs,mjs,ts,tsx}"],
    "ignoreBinaries": ["eslint"],
    "ignoreDependencies": ["prettier-plugin-organize-imports"],
}
