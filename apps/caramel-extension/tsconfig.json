{
    "extends": "./.wxt/tsconfig.json",
    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "skipLibCheck": true,
        // The ported extension sources are plain-JS ES modules; the .ts
        // entrypoints import them, so tsc infers their types from the real
        // code (no hand-written declarations to drift). checkJs stays off —
        // the .js bodies' own annotation debt is not this gate's business.
        "allowJs": true,
        "checkJs": false,
        // @wxt-dev/module-react configures Vite's JSX transform but NOT the
        // generated .wxt/tsconfig.json (WXT 0.21.4) — without this line the
        // type-check gate dies on every .tsx file while `wxt build` succeeds.
        "jsx": "react-jsx"
    },
    "include": ["entrypoints", "types", "wxt.config.ts", ".wxt/wxt.d.ts"]
}
