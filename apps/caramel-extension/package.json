{
    "name": "caramel-extension",
    "version": "1.4.19",
    "description": "Caramel browser extension",
    "private": true,
    "scripts": {
        "lint": "eslint .",
        "prettier-check": "prettier --check '**/*.{js,html,css,json,md}'",
        "prettier-write": "prettier --write '**/*.{js,html,css,json,md}'",
        "build": "wxt build",
        "build:dev": "wxt build --mode development",
        "build:firefox": "wxt build -b firefox --mv3",
        "postinstall": "wxt prepare",
        "type-check": "wxt prepare && tsc --noEmit",
        "package": "wxt zip",
        "dev": "wxt",
        "test": "vitest run",
        "test:e2e": "node scripts/test-extension.mjs",
        "test:guards": "node scripts/test-guards.mjs",
        "test:autodetect": "node scripts/test-autodetect.mjs",
        "test:smoke": "node scripts/smoke-package.mjs ./.output/chrome-mv3 production",
        "test:parity": "node scripts/parity-harness.mjs",
        "size": "node scripts/measure-size.mjs && size-limit",
        "knip": "knip"
    },
    "devDependencies": {
        "@size-limit/file": "14.3.0",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@wxt-dev/module-react": "1.2.2",
        "esbuild": "0.28.2",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-html": "8.2.1",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-prettier": "5.5.7",
        "jsdom": "30.1.3",
        "knip": "6.42.1",
        "playwright": "1.64.1",
        "prettier": "3.9.10",
        "prettier-plugin-organize-imports": "4.3.0",
        "size-limit": "14.3.0",
        "typescript": "5.9.3",
        "vitest": "5.0.5",
        "web-ext": "10.8.0",
        "wxt": "0.21.4"
    },
    "dependencies": {
        "caramel-ui": "workspace:*",
        "react": "19.3.1",
        "react-dom": "19.3.1"
    }
}
