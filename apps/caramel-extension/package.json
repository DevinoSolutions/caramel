{
    "name": "caramel-extension",
    "version": "1.3.1",
    "description": "Caramel browser extension",
    "private": true,
    "scripts": {
        "lint": "eslint .",
        "prettier-check": "prettier --check '**/*.{js,html,css,json,md}'",
        "prettier-write": "prettier --write '**/*.{js,html,css,json,md}'",
        "build": "wxt build",
        "build:dev": "wxt build --mode development",
        "build:firefox": "wxt build -b firefox --mv3",
        "postinstall": "wxt prepare",
        "type-check": "wxt prepare && tsc --noEmit",
        "package": "wxt zip",
        "dev": "wxt",
        "test": "vitest run",
        "test:e2e": "node scripts/test-extension.mjs",
        "test:guards": "node scripts/test-guards.mjs",
        "test:smoke": "node scripts/smoke-package.mjs ./.output/chrome-mv3 production",
        "test:parity": "node scripts/parity-harness.mjs",
        "size": "node scripts/measure-size.mjs && size-limit",
        "knip": "knip"
    },
    "devDependencies": {
        "@size-limit/file": "12.1.0",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.4",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@wxt-dev/module-react": "1.2.2",
        "esbuild": "0.25.12",
        "eslint-config-prettier": "10.1.5",
        "eslint-plugin-html": "8.1.3",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-prettier": "5.5.1",
        "jsdom": "29.0.2",
        "knip": "5.70.2",
        "playwright": "1.59.1",
        "prettier": "3.6.2",
        "prettier-plugin-organize-imports": "4.1.0",
        "size-limit": "12.1.0",
        "typescript": "5.9.2",
        "vitest": "4.1.10",
        "web-ext": "8.10.0",
        "wxt": "0.21.4"
    },
    "dependencies": {
        "caramel-ui": "workspace:*",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    }
}
