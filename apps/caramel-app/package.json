{
    "name": "caramel-app",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "npx prisma generate && next dev -p 58000",
        "build": "npx prisma generate && next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "type-check": "tsc --noEmit",
        "db:push": "prisma db push",
        "db:generate": "prisma generate",
        "db:studio": "prisma studio",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:migrate:reset": "prisma migrate reset",
        "prettier-check": "prettier --check '**/*.{ts,tsx,js,jsx,html,css,json,md}'",
        "prettier-write": "prettier --write '**/*.{ts,tsx,js,jsx,html,css,json,md}'",
        "knip": "knip",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "eval": "vitest run --config vitest.eval.config.ts",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "setup:ci-env": "tsx scripts/ci-env.ts",
        "seed:e2e-user": "tsx scripts/seed-e2e-user.ts",
        "coupons:clone-local": "bash scripts/internal/clone-coupons-local.sh",
        "smoke": "tsx scripts/smoke.ts",
        "email:health": "tsx scripts/email-delivery-health.ts",
        "generate:coupon-constants": "tsx scripts/generate-coupon-constants.ts",
        "bridge:sync": "tsx scripts/bridge-sync.ts",
        "audit:prod": "tsx scripts/audit-prod-deps.ts",
        "lighthouse": "lhci autorun"
    },
    "dependencies": {
        "@heroicons/react": "2.2.0",
        "@prisma/adapter-pg": "7.10.1",
        "@prisma/client": "7.10.1",
        "@react-email/render": "2.1.1",
        "@react-three/drei": "10.7.9",
        "@react-three/fiber": "9.8.2",
        "@sentry/nextjs": "11.8.0",
        "@tailwindcss/postcss": "4.3.3",
        "@use-gesture/react": "10.3.1",
        "bcryptjs": "3.0.3",
        "better-auth": "1.7.12",
        "formik": "2.4.9",
        "framer-motion": "14.6.0",
        "gsap": "3.15.0",
        "jose": "6.2.3",
        "lodash.debounce": "4.0.8",
        "next": "16.4.2",
        "postgres": "3.4.9",
        "posthog-js": "1.438.17",
        "posthog-node": "5.57.0",
        "prisma": "7.10.1",
        "rate-limiter-flexible": "11.2.3",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-fast-marquee": "1.6.5",
        "react-icons": "5.7.0",
        "react-infinite-scroll-component": "7.2.1",
        "react-lottie-player": "2.1.0",
        "react-select": "5.10.2",
        "react-type-animation": "3.2.0",
        "recharts": "3.10.1",
        "sass": "1.106.1",
        "sendly-sdk": "1.1.0",
        "server-only": "0.0.1",
        "sonner": "2.0.8",
        "three": "0.186.1",
        "tldts": "7.4.19",
        "yup": "1.7.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@argos-ci/cli": "6.11.0",
        "@argos-ci/playwright": "7.8.0",
        "@lhci/cli": "0.15.1",
        "@playwright/test": "1.64.1",
        "@testing-library/react": "16.3.3",
        "@types/gtag.js": "0.0.20",
        "@types/lodash.debounce": "4.0.9",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/three": "0.186.0",
        "@typescript-eslint/parser": "8.72.0",
        "eslint-config-next": "16.4.2",
        "jsdom": "30.1.3",
        "knip": "6.42.1",
        "postcss": "8.5.31",
        "prettier": "3.9.10",
        "prettier-plugin-organize-imports": "4.3.0",
        "prettier-plugin-tailwindcss": "0.6.14",
        "tsx": "4.23.15",
        "typescript": "5.9.3",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "5.0.5"
    }
}
