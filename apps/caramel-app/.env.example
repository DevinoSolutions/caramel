# Database — credentials match the role docker-compose.yml creates.
DATABASE_URL="postgresql://caramel:caramel_password@localhost:28005/caramel?schema=public"
# OPTIONAL (W4-D3) — bridge-sync ONLY, so it ships COMMENTED OUT: leave it
# unset for local dev — the app serves its OWN coupon catalog, which lives in
# DATABASE_URL (created by `prisma migrate deploy` + the catalog seed).
# Uncomment ONLY to run the migration-period `bridge:sync` job, which pulls the
# external, Python-owned caramel_coupons Postgres (read-only) into that
# catalog. Consumed by the raw `postgres` driver (not Prisma) — no ?schema=
# param. Never leave it uncommented-but-empty: env.ts's `.min(1)` fails fast at
# boot on a set-but-empty value. The example value below is illustrative only.
# COUPONS_DATABASE_URL="postgresql://caramel:caramel_password@localhost:28005/caramel_coupons"

# Auth (Better Auth / JWT) — at least one of BETTER_AUTH_SECRET or JWT_SECRET is required
JWT_SECRET=your-jwt-secret-here
BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=http://localhost:28000
BCRYPT_SALT_ROUNDS=10

# Catalog staleness window (hours) for GET /api/health/db's catalog check.
# Staleness alone never fails the check — this only tunes when the reported
# `details.stale` flag flips true. Optional; defaults to 48.
CATALOG_MAX_AGE_HOURS=48

# Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:28000

# Social sign-in (optional — a provider is skipped when its vars are unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# Apple has NO static client secret: the app signs its own ES256 JWT from the
# .p8 key at runtime (src/lib/auth/appleClientSecret.ts). When APPLE_CLIENT_ID
# is set, ALL THREE below are required (boot fails fast otherwise). Leave them
# empty with APPLE_CLIENT_ID unset to keep Apple sign-in disabled.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of AuthKey_<KEY_ID>.p8, on ONE line with literal \n between the
# lines (Dokploy stores env values unquoted on one line); real newlines work too.
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

# Browser extension integration
EXTENSION_OAUTH_STATE_SECRET=
# chrome-extension://<id>. Besides CORS, its <id> is added to the OAuth redirect
# allowlist (src/lib/auth/extensionOAuthRedirect.ts) — set it to an unpacked
# build's ID to sign in from that build; the store IDs are always allowed.
CHROME_EXTENSION_ORIGIN=
FIREFOX_EXTENSION_ORIGIN=
SAFARI_EXTENSION_ORIGIN=

# CORS allow-list for mutation routes (comma-separated origins, in addition to same-origin + extensions)
ALLOWED_ORIGINS=

# Server-to-server bearer secret — never shipped to any client. Gates POST
# /api/coupons/expire and the rate-limit trust exemption (src/lib/rateLimit.ts).
COUPONS_ADMIN_SECRET=

# Server-to-server bearer for the coupons pipeline supplier — never shipped to
# any client. Gates POST /api/ingest/catalog (the ownership-inversion ingest
# endpoint; the pipeline pushes catalog rows to the app).
INGEST_API_KEY=

# DEV-ONLY proof path (T-9413). Enables POST /api/dev-proof/session, which mints a
# session bearer for a throwaway devproof+<slug>@devino.ca user (min 32 chars).
# DEV COMPOSE ONLY — NEVER set this in production (grabcaramel.com): production
# must not have the variable at all, and the route also refuses production hosts
# even when it is set. Left commented because a set-but-short value fails the boot.
# DEV_PROOF_SESSION_SECRET=

# Health check
UPKUMA_HEALTH_SECRET=

# Sendly Email (the ONLY email transport; useSend and Resend are retired).
# API key from https://sendly.now with the scopes `emails:send` (sending) and
# `emails:read` (the delivery-health check below lists sent mail). grabcaramel.com
# lives in the SHARED Sendly "Devino" project and a key cannot be limited to one
# domain, so the health check is always filtered to SENDLY_FROM_EMAIL's address.
# Unset → boot works, every send throws loudly.
SENDLY_API_KEY=
# Bare address only (no "Name <...>"); a malformed or empty value fails the boot.
SENDLY_FROM_EMAIL=no_reply@grabcaramel.com
SENDLY_FROM_NAME=Caramel
# Optional: only to aim the SDK at a non-production API (default
# https://api.sendly.now). Shipped commented out — leave unset in production.
# SENDLY_BASE_URL=
# Async delivery health: once per interval the server asks Sendly's own email
# list (GET /api/emails, newest first) what happened to the mail we sent, and a
# window containing BOUNCED/FAILED/REJECTED/RENDERING_FAILURE/complained sends —
# or sends stuck in PENDING/SENDING/SENT — raises ONE Sentry event. Leave unset:
# it is ON in production when SENDLY_API_KEY is set, OFF everywhere else.
# 'false' opts prod out; 'true' forces it on locally.
# Shipped commented out: a set-but-EMPTY value fails env.ts's true|false enum
# at boot (same pattern as COUPONS_DATABASE_URL above).
# EMAIL_DELIVERY_HEALTH_ENABLED=
# Minutes between runs AND the window each run reads; must tile the UTC day
# (a divisor of 60 that is at least 5, or whole hours dividing 24). Runs sit at minute 23 UTC.
EMAIL_DELIVERY_HEALTH_INTERVAL_MINUTES=60
# Destination inbox(es) for the support/feedback flow (POST /api/support).
# Comma-separated list supported ("ops1@example.com,ops2@example.com") — every
# address gets the notification. Real addresses live only in the deploy env,
# never in this public file. Empty value → email step is 'skipped' (analytics
# still captured).
# TODO(sendly): move to a per-app Sendly-hosted inbox (support@grabcaramel.com)
# once Sendly custom domains are ready, so support requests are MCP-readable.
SUPPORT_EMAIL_TO=support-team@example.com,second-operator@example.com

# OpenRouter (extension cart classifier)
# Does a `supported` site-suggestion ack mail the requester automatically?
# 'false' (the default) = the app only MARKS the row; the notice is sent by an
# explicit POST /api/ingest/site-suggestions/notify. Only 'true' or 'false' —
# anything else fails boot rather than being guessed at.
SITE_SUGGESTIONS_AUTO_NOTIFY=false

# Global switch for shopper-typed coupon codes CAPTURED AT CHECKOUT by the
# extension (POST /api/coupons/submit with source "checkout"; the extension reads
# it from GET /api/extension/features). The code default stays false, and prod
# stays false until a consent-carrying extension build (1.4.9+) is the LIVE
# version in every store that ships Caramel (Chrome, Firefox, Edge, Safari):
# capture is opt-in per shopper (owner rule 2026-10-06) and builds 1.4.3-1.4.7
# would capture by default with no prompt. The flag is GLOBAL and only the
# server's half; the route also refuses (403 consent-required) any checkout
# submission that does not carry the extension's consent proof, so this gate
# must be on prod BEFORE the flag is turned on. It gates ONLY the automatic
# capture: the website's manual "Add a code" form works either way.
# Only 'true' or 'false' — anything else fails boot.
SHOPPER_CODE_CAPTURE_ENABLED=false
# Served to the extension (GET /api/extension/features): may it find a store's
# promo box itself when no config describes it? Off = copy-the-codes fallback.
# Only 'true' or 'false' — anything else fails boot.
COUPON_BOX_DISCOVERY_ENABLED=false
# Served to the extension (GET /api/extension/features as couponBoxSave): when
# the extension finds and proves a promo box on a store with no config, may it
# save that box as the store's config (POST /api/extension/coupon-box-save)?
# A pipeline config pushed later always replaces a saved one. Needs a signed-in
# extension (bearer). Off = the route answers 404 and nothing is saved. Only
# 'true' or 'false' — anything else fails boot.
COUPON_BOX_SAVE_ENABLED=false
# A saved box is only a PROPOSAL until this many DISTINCT signed-in users
# (accounts at least COUPON_TRUST_MIN_ACCOUNT_AGE_DAYS old) proposed the same box
# for the same store, each right after reporting a code there as worked; then
# it becomes the store's served config (T-6221, T-10535). Integer >= 2;
# blank = 2. Counts accounts, so it is a cost to an attacker, not proof.
COUPON_BOX_SAVE_MIN_AGREEING_INSTALLS=2
# Daily write budget: NEW proposals per user, per store and in total over the
# last 24 hours. Over a cap the route answers 429 and writes nothing. Integers
# >= 0 (0 = refuse every save on that axis); blank = 10 / 20 / 500.
COUPON_BOX_SAVE_USER_DAILY_CAP=10
COUPON_BOX_SAVE_STORE_DAILY_CAP=20
COUPON_BOX_SAVE_GLOBAL_DAILY_CAP=500

OPENROUTER_API_KEY=
# Base URL of the OpenAI-compatible chat API (the app POSTs <base>/chat/completions).
# Empty = OpenRouter (https://openrouter.ai/api/v1). Set to the Devino proxy
# (https://proxyai.devino.ca/v1) to route the cart classifier there; the key
# above must then be a proxy key and OPENROUTER_MODEL a proxy pin (see
# evals/SCOREBOARD.md for the eval-gated pin). Unset it to roll back.
OPENROUTER_API_URL=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Coupon-box pick: a model picks the coupon box when the extension's rules
# cannot find it. Live only when ENABLED is 'true' AND a model is set (the
# extension reads the same switch from /api/extension/features). Only 'true'
# or 'false' — anything else fails boot. Uses the OPENROUTER_API_URL/KEY above.
COUPON_BOX_LLM_ENABLED=false
# Model id for the pick; empty keeps the feature off. Eval-gate a model with
# evals/couponBoxPick.eval.ts before setting it.
COUPON_BOX_PICK_MODEL=
# Per-day cap on UNCACHED coupon-box model calls, process-wide (default 2000).
# A non-negative integer; 0 = no model calls at all (soft kill switch, see
# RUNBOOK.md "coupon-box pick: switch on / kill switch"). Past the cap the route
# answers 429 until the 24h window ends.
COUPON_BOX_PICK_DAILY_CAP=2000
# Coupon trust signals (T-6222 / T-6227). Non-negative / positive integers.
# Accounts younger than this many days count as an anonymous network toward a
# failure quorum and may not stamp "worked" on a code someone else listed
# (default 7; 0 = every account is established).
COUPON_TRUST_MIN_ACCOUNT_AGE_DAYS=7
# Most worked reports, and most failed reports, counted per coupon per hour from
# ALL reporters together (default 10). Over it a report is accepted, not counted.
COUPON_REPORT_MAX_PER_COUPON_PER_HOUR=10
# The same hourly cap for LOW-TRUST reporters alone (anonymous networks, accounts
# younger than the age gate): a separate, smaller bucket (default 5).
COUPON_REPORT_MAX_LOW_TRUST_PER_COUPON_PER_HOUR=5
# Most "worked" stamps one account may make in a rolling 24h, through the
# extension's checkout code capture and POST /api/coupons/<id>/report (default
# 30). Past it an established account's "worked" report counts as low-trust.
COUPON_WORKED_STAMPS_PER_USER_PER_DAY=30
# Caramel sends no paid-fallback headers today: both LLM routes are guest-reachable.
# Paid fallback through the Devino proxy (optional, server-only, never in CI/evals).
# OPENROUTER_FALLBACK_API_KEY: this app's own OpenRouter org key (sk-or-v1-...),
#   sent only to https://proxyai.devino.ca; set its $5/week limit in OpenRouter first.
# OPENROUTER_FALLBACK_MODEL: optional paid model id (proxy default deepseek/deepseek-v4.1-flash);
#   it must accept every parameter this app sends (e.g. reasoning, response_format).
# OPENROUTER_FALLBACK_AFTER_SECONDS: optional, a plain number above 0 and at most 12; code default 8.
# Guests never get the paid path. Each model request can go paid once (no paid retries);
#   an agent turn is one request per step. The key's $5/week limit is the only hard cap.
OPENROUTER_FALLBACK_API_KEY=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_FALLBACK_AFTER_SECONDS=

# Response encryption (server + client flags must agree)
API_ENCRYPTION_ENABLED=
NEXT_PUBLIC_API_ENCRYPTION_ENABLED=

# Observability
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# PostHog is off unless the key is set; the host defaults to the self-hosted
# instance, so only the key is needed to turn it on.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# PostHog (feedback + observability). Dataset routing keeps synthetic E2E
# traffic out of the production project. Values: production | e2e | disabled.
# Leave DISABLED locally — capture then no-ops everywhere (server + browser).
# The server var (POSTHOG_DATASET) and the browser var
# (NEXT_PUBLIC_POSTHOG_DATASET) MUST match when both are set — env.ts fail-fasts
# on a mismatch.
POSTHOG_DATASET=disabled
NEXT_PUBLIC_POSTHOG_DATASET=disabled
# production capture pair (required when either dataset var is 'production').
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_KEY=
# shared E2E test-project capture pair (required when dataset is 'e2e').
NEXT_PUBLIC_POSTHOG_E2E_TEST_PROJECT_HOST=
NEXT_PUBLIC_POSTHOG_E2E_TEST_PROJECT_CAPTURE_TOKEN=
# Browser URL of this deploy's PostHog project UI, PROJECT ID INCLUDED
# (e.g. https://posthog.example.com/project/123). Powers the "open in PostHog"
# deep link in support emails; unset → the email carries no link. Real value
# lives only in the deploy env.
POSTHOG_PROJECT_UI_URL=
# Account deletion deletes the user's PostHog person and events through
# PostHog's private API (src/lib/analytics/posthogPersonDeletion.ts). Needs a
# personal API key with ONLY the person:write scope and the numeric id of the
# project POSTHOG_DATASET captures into; the API host is NEXT_PUBLIC_POSTHOG_HOST.
# Both optional: unset, accounts still delete and the gap goes to Sentry. Secret:
# deploy env only, never commit a value.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# App version stamp — auto-injected by next.config.mjs from package.json.
# Documented here for completeness; do NOT set it by hand.
# NEXT_PUBLIC_APP_VERSION=
#
# NEVER set POSTHOG_E2E_TEST_PROJECT_QUERY_READ_ONLY_PERSONAL_API_KEY in this
# file or any app/server/container env — it is a Playwright/CI-only read key
# and env.ts fail-fasts at boot if it is present here (key-hygiene guard).

# NODE_ENV is deliberately NOT listed: it is framework-managed (Next.js sets it
# per command; env files cannot override it) — see README "Local defaults".
