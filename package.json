{
    "packageManager": "pnpm@9.0.0",
    "engines": {
        "node": ">=22"
    },
    "workspaces": [
        "apps/*"
    ],
    "pnpm": {
        "overrides": {
            "shell-quote": "1.11.0",
            "web-ext>tmp": "0.2.7",
            "undici": "7.30.0",
            "effect": "3.20.0",
            "vitest>picomatch": "4.0.4",
            "postcss": "8.5.23",
            "sharp": "0.35.5",
            "fast-uri": "3.1.8",
            "brace-expansion@5": "5.0.12",
            "nanoid@<3.3.18": "3.3.18",
            "yaml@<1.10.3": "1.10.3",
            "deepmerge-ts@<8.0.0": "8.0.1",
            "browserslist": "4.28.7",
            "source-map-js": "1.2.2",
            "fflate@>=0.6.0 <0.6.11": "0.6.11",
            "dompurify@<3.4.16": "3.4.16",
            "brace-expansion@<1.1.21": "1.1.21",
            "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
            "minimatch@<3.1.4": "3.1.5",
            "minimatch@>=9.0.0 <9.0.7": "9.0.9",
            "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
            "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
            "adm-zip@<0.6.1": "0.6.1",
            "image-size@<2.0.3": "2.0.3",
            "smol-toml@<1.9.0": "1.9.0",
            "tmp@<0.2.6": "0.2.7",
            "proxy-addr@<2.0.8": "2.0.8",
            "compression@<1.8.2": "1.8.2",
            "ip-address@<10.7.1": "10.7.1",
            "qs@<6.16.0": "6.16.0",
            "glob@>=10.0.0 <10.5.0": "10.5.0",
            "convict@<6.2.5": "6.2.5",
            "ajv@>=8.0.0 <8.18.0": "8.20.0",
            "@babel/core@<7.29.6": "7.29.6",
            "postcss-selector-parser@>=6.0.0 <6.1.3": "6.1.3"
        }
    },
    "scripts": {
        "dev": "docker compose up --build",
        "dev:next": "pnpm --filter caramel-app dev",
        "dev:extension": "pnpm --filter caramel-extension dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "lint:oxlint": "oxlint",
        "test": "turbo run test",
        "test:eslint-rules": "node --test tools/eslint-rules/*.test.mjs",
        "prettier-write": "turbo run prettier-write",
        "prettier-check": "turbo run prettier-check",
        "prettier-check:root": "prettier --check '*.{json,md,mjs,yaml,yml}' '.*.{json,yaml,yml}' '.claude-plugin/**/*.json' 'plugins/**/*.{json,md}' '.github/**/*.{yml,yaml,md}' 'tools/**/*.{mjs,md}'",
        "prettier-write:root": "prettier --write '*.{json,md,mjs,yaml,yml}' '.*.{json,yaml,yml}' '.claude-plugin/**/*.json' 'plugins/**/*.{json,md}' '.github/**/*.{yml,yaml,md}' 'tools/**/*.{mjs,md}'",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,mjs,cjs}": [
            "oxlint",
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css,yaml,yml}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "eslint": "9.31.0",
        "eslint-config-next": "16.0.3",
        "eslint-config-prettier": "10.1.5",
        "husky": "9.1.7",
        "lint-staged": "16.4.0",
        "oxlint": "1.73.0",
        "playwright": "1.59.1",
        "prettier": "3.6.2",
        "prettier-plugin-organize-imports": "4.1.0",
        "prettier-plugin-tailwindcss": "0.6.14",
        "turbo": "2.9.14"
    }
}
